# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# These variables are read by db_config.py (when running locally) and by
# docker-compose.yml (when running in containers).

DB_NAME=financial_news
DB_USER=postgres
DB_PASSWORD=change_me

# Use localhost when running directly on your machine.
# Inside Docker, compose automatically sets DB_HOST=db for you — leave this as-is.
DB_HOST=localhost
DB_PORT=5432
